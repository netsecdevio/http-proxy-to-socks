{
  "name": "http-proxy-to-socks",
  "version": "1.2.0",
  "description": "hpts(http-proxy-to-socks) is a nodejs client to convert socks proxy into http proxy",
  "main": "lib/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netsecdevio/http-proxy-to-socks.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint src scripts",
    "test": "npm run lint && node --test 'src/__tests__/*.spec.js'",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "socks",
    "http proxy",
    "converting proxy"
  ],
  "bin": {
    "hpts": "bin/hpts.js"
  },
  "author": "oyyd <oyydoibh@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "socks": "^2.8.10",
    "socks-proxy-agent": "^8.0.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
